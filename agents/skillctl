#!/usr/bin/env python3
"""skillctl — inspect and set agent-skill invocation state per harness.

Frontmatter in each skill's SKILL.md is the editable source of truth.
`disable-model-invocation` controls Claude; `disable-codex-model-invocation`
optionally overrides Codex.
`sync` projects it into the Codex dialect (agents/openai.yaml policy blocks)
and maintains categorized per-skill symlinks in ~/.codex/skills. Idempotent.

Modes per harness:
  model — model-invoked: description loads into every session turn.
  user  — user-invoked: fires only by name.
  off   — SKILL.md renamed to SKILL.off.md: invisible to every harness.

Commands:
  skillctl list
  skillctl enable-model <skill> [claude|codex|all]
  skillctl disable-model <skill> [claude|codex|all]
  skillctl off <skill> | on <skill>
  skillctl sync
"""

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
SKILLS = ROOT / "skills"
CODEX_SKILLS = Path.home() / ".codex" / "skills"
POLICY_HEADER = "# policy block generated by skillctl sync; edit frontmatter instead"
POLICY_BLOCK = POLICY_HEADER + "\npolicy:\n  allow_implicit_invocation: false\n"


def skill_dirs():
    # Skills live one level below category folders (skills/<category>/<name>).
    # A dir is a skill iff it holds SKILL.md or SKILL.off.md; names are
    # globally unique across categories (invocation still uses the skill name).
    dirs = [
        d
        for cat in SKILLS.iterdir()
        if cat.is_dir() and not cat.name.startswith(".")
        for d in cat.iterdir()
        if d.is_dir()
        and not d.name.startswith(".")
        and ((d / "SKILL.md").exists() or (d / "SKILL.off.md").exists())
    ]
    names = [d.name for d in dirs]
    dupes = {n for n in names if names.count(n) > 1}
    if dupes:
        sys.exit(f"skillctl: duplicate skill names across categories: {sorted(dupes)}")
    return sorted(dirs, key=lambda d: d.name)


def skill_file(d):
    live, off = d / "SKILL.md", d / "SKILL.off.md"
    if live.exists():
        return live, False
    if off.exists():
        return off, True
    return None, False


def parse_frontmatter(text):
    m = re.match(r"\A---\n(.*?)\n---\n", text, re.DOTALL)
    if not m:
        return {}
    fm = {}
    for line in m.group(1).splitlines():
        km = re.match(r"^([A-Za-z-]+):\s*(.*)$", line)
        if km:
            fm[km.group(1)] = km.group(2).strip().strip('"')
    return fm


def modes_of(d):
    f, is_off = skill_file(d)
    if f is None:
        return {"claude": "?", "codex": "?"}, {}
    fm = parse_frontmatter(f.read_text())
    if is_off:
        return {"claude": "off", "codex": "off"}, fm
    claude = "user" if fm.get("disable-model-invocation") == "true" else "model"
    codex_override = fm.get("disable-codex-model-invocation")
    if codex_override in ("true", "false"):
        codex = "user" if codex_override == "true" else "model"
    else:
        codex = claude
    return {"claude": claude, "codex": codex}, fm


def cmd_list():
    rows = [(d.name, *modes_of(d)) for d in skill_dirs()]
    loaded = {"claude": 0, "codex": 0}
    print(f"{'SKILL':<36} {'CLAUDE':<6} {'CODEX':<6} {'~TOK':>5}  DESCRIPTION")
    for name, modes, fm in rows:
        desc = fm.get("description", "")
        tokens = (len(name) + len(desc)) // 4
        for harness in loaded:
            if modes[harness] == "model":
                loaded[harness] += tokens
        shown = desc if len(desc) <= 90 else desc[:87] + "..."
        print(
            f"{name:<36} {modes['claude']:<6} {modes['codex']:<6} "
            f"{tokens:>5}  {shown}"
        )
    print(
        "\nalways-loaded description cost: "
        f"claude~{loaded['claude']} codex~{loaded['codex']} tokens"
    )


def find(name):
    matches = [d for d in skill_dirs() if d.name == name]
    if not matches:
        sys.exit(f"skillctl: no skill '{name}' in {SKILLS}")
    return matches[0]


def set_flag(name, disabled, harness):
    d = find(name)
    f, is_off = skill_file(d)
    if f is None:
        sys.exit(f"skillctl: '{name}' has no SKILL.md")
    text = f.read_text()
    modes, _ = modes_of(d)
    enabled = {key: value == "model" for key, value in modes.items()}
    targets = ("claude", "codex") if harness == "all" else (harness,)
    for target in targets:
        enabled[target] = not disabled
    m = re.match(r"\A---\n(.*?)\n---\n", text, re.DOTALL)
    if not m:
        sys.exit(f"skillctl: '{name}' has no frontmatter")
    fm_body = re.sub(
        r"^disable-(?:codex-)?model-invocation:.*\n?",
        "",
        m.group(1) + "\n",
        flags=re.M,
    ).rstrip("\n")
    if not enabled["claude"]:
        fm_body += "\ndisable-model-invocation: true"
    if enabled["codex"] != enabled["claude"]:
        fm_body += (
            "\ndisable-codex-model-invocation: "
            + ("false" if enabled["codex"] else "true")
        )
    f.write_text(f"---\n{fm_body}\n---\n" + text[m.end():])
    print(
        f"{name}: claude={'model' if enabled['claude'] else 'user'} "
        f"codex={'model' if enabled['codex'] else 'user'}"
    )
    cmd_sync()


def set_off(name, off):
    d = find(name)
    f, is_off = skill_file(d)
    if f is None:
        sys.exit(f"skillctl: '{name}' has no SKILL.md")
    if off and not is_off:
        f.rename(d / "SKILL.off.md")
    elif not off and is_off:
        f.rename(d / "SKILL.md")
    print(f"{name}: {'off' if off else 'on'}")
    cmd_sync()


def sync_yaml(d, mode):
    yaml_path = d / "agents" / "openai.yaml"
    existing = yaml_path.read_text() if yaml_path.exists() else ""
    # Strip any policy block we own (header comment + top-level policy: + indented lines).
    kept = re.sub(
        rf"(?:^{re.escape(POLICY_HEADER)}\n)?^policy:\n(?:[ \t]+.*\n?)*",
        "",
        existing,
        flags=re.M,
    ).strip("\n")
    parts = [kept] if kept else []
    if mode == "user":
        parts.append(POLICY_BLOCK.rstrip("\n"))
    new = ("\n".join(parts) + "\n") if parts else ""
    if new == existing:
        return False
    if new:
        yaml_path.parent.mkdir(exist_ok=True)
        yaml_path.write_text(new)
    elif yaml_path.exists():
        yaml_path.unlink()
        if not any(yaml_path.parent.iterdir()):
            yaml_path.parent.rmdir()
    return True


def cmd_sync():
    changed = 0
    CODEX_SKILLS.mkdir(parents=True, exist_ok=True)
    expected_links = set()
    for d in skill_dirs():
        modes, _ = modes_of(d)
        if modes["codex"] == "?":
            continue
        if sync_yaml(d, modes["codex"]):
            changed += 1
        category_dir = CODEX_SKILLS / d.parent.name
        category_dir.mkdir(exist_ok=True)
        link = category_dir / d.name
        expected_links.add(link)
        if link.is_symlink():
            if link.resolve() != d.resolve():
                link.unlink()
        elif link.exists():
            print(f"warning: {link} exists and is not a symlink; leaving it alone")
            continue
        if not link.is_symlink():
            link.symlink_to(d)
            changed += 1
    # Prune obsolete flat links, moved links, and links to retired managed skills.
    for link in CODEX_SKILLS.glob("**/*"):
        if link.is_symlink():
            target = link.resolve(strict=False)
            if str(target).startswith(str(SKILLS)) and (
                link not in expected_links or not target.exists()
            ):
                link.unlink()
                changed += 1
    print(f"sync: {'no changes' if changed == 0 else f'{changed} change(s)'}")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    cmd, rest = args[0], args[1:]
    if cmd == "list":
        cmd_list()
    elif cmd == "sync":
        cmd_sync()
    elif cmd in ("enable-model", "disable-model") and len(rest) in (1, 2):
        harness = rest[1] if len(rest) == 2 else "all"
        if harness not in ("claude", "codex", "all"):
            sys.exit(f"skillctl: unknown harness {harness!r}; use claude, codex, or all")
        set_flag(rest[0], cmd == "disable-model", harness)
    elif cmd in ("off", "on") and len(rest) == 1:
        set_off(rest[0], cmd == "off")
    else:
        sys.exit(f"skillctl: unknown command {' '.join(args)!r} (see --help)")


if __name__ == "__main__":
    main()
