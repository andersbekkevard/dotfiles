#!/usr/bin/env python3
"""skillctl — inspect and flip agent-skill invocation state.

Frontmatter in each skill's SKILL.md is the editable source of truth.
`sync` projects it into the Codex dialect (agents/openai.yaml policy blocks)
and maintains the per-skill symlinks in ~/.codex/skills. Idempotent.

Modes:
  model — model-invoked: description loads into every session turn.
  user  — user-invoked (disable-model-invocation: true): fires only by name.
  off   — SKILL.md renamed to SKILL.off.md: invisible to every harness.

Commands:
  skillctl list
  skillctl enable-model <skill> | disable-model <skill>
  skillctl off <skill> | on <skill>
  skillctl sync
"""

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
SKILLS = ROOT / "skills"
CODEX_SKILLS = Path.home() / ".codex" / "skills"
POLICY_HEADER = "# policy block generated by skillctl sync; edit frontmatter instead"
POLICY_BLOCK = POLICY_HEADER + "\npolicy:\n  allow_implicit_invocation: false\n"


def skill_dirs():
    # Skills live one level below category folders (skills/<category>/<name>).
    # A dir is a skill iff it holds SKILL.md or SKILL.off.md; names are
    # globally unique across categories (the harness link namespace is flat).
    dirs = [
        d
        for cat in SKILLS.iterdir()
        if cat.is_dir() and not cat.name.startswith(".")
        for d in cat.iterdir()
        if d.is_dir()
        and not d.name.startswith(".")
        and ((d / "SKILL.md").exists() or (d / "SKILL.off.md").exists())
    ]
    names = [d.name for d in dirs]
    dupes = {n for n in names if names.count(n) > 1}
    if dupes:
        sys.exit(f"skillctl: duplicate skill names across categories: {sorted(dupes)}")
    return sorted(dirs, key=lambda d: d.name)


def skill_file(d):
    live, off = d / "SKILL.md", d / "SKILL.off.md"
    if live.exists():
        return live, False
    if off.exists():
        return off, True
    return None, False


def parse_frontmatter(text):
    m = re.match(r"\A---\n(.*?)\n---\n", text, re.DOTALL)
    if not m:
        return {}
    fm = {}
    for line in m.group(1).splitlines():
        km = re.match(r"^([A-Za-z-]+):\s*(.*)$", line)
        if km:
            fm[km.group(1)] = km.group(2).strip().strip('"')
    return fm


def mode_of(d):
    f, is_off = skill_file(d)
    if f is None:
        return "?", {}
    fm = parse_frontmatter(f.read_text())
    if is_off:
        return "off", fm
    if fm.get("disable-model-invocation") == "true":
        return "user", fm
    return "model", fm


def cmd_list():
    rows = [(d.name, *mode_of(d)) for d in skill_dirs()]
    loaded = 0
    print(f"{'SKILL':<36} {'MODE':<6} {'~TOK':>5}  DESCRIPTION")
    for name, mode, fm in rows:
        desc = fm.get("description", "")
        tokens = (len(name) + len(desc)) // 4
        if mode == "model":
            loaded += tokens
        shown = desc if len(desc) <= 90 else desc[:87] + "..."
        print(f"{name:<36} {mode:<6} {tokens:>5}  {shown}")
    print(f"\nalways-loaded description cost (model-invoked only): ~{loaded} tokens")


def find(name):
    matches = [d for d in skill_dirs() if d.name == name]
    if not matches:
        sys.exit(f"skillctl: no skill '{name}' in {SKILLS}")
    return matches[0]


def set_flag(name, disabled):
    d = find(name)
    f, is_off = skill_file(d)
    if f is None:
        sys.exit(f"skillctl: '{name}' has no SKILL.md")
    text = f.read_text()
    m = re.match(r"\A---\n(.*?)\n---\n", text, re.DOTALL)
    if not m:
        sys.exit(f"skillctl: '{name}' has no frontmatter")
    fm_body = re.sub(r"^disable-model-invocation:.*\n?", "", m.group(1) + "\n", flags=re.M).rstrip("\n")
    if disabled:
        fm_body += "\ndisable-model-invocation: true"
    f.write_text(f"---\n{fm_body}\n---\n" + text[m.end():])
    print(f"{name}: mode -> {'user' if disabled else 'model'}")
    cmd_sync()


def set_off(name, off):
    d = find(name)
    f, is_off = skill_file(d)
    if f is None:
        sys.exit(f"skillctl: '{name}' has no SKILL.md")
    if off and not is_off:
        f.rename(d / "SKILL.off.md")
    elif not off and is_off:
        f.rename(d / "SKILL.md")
    print(f"{name}: {'off' if off else 'on'}")
    cmd_sync()


def sync_yaml(d, mode):
    yaml_path = d / "agents" / "openai.yaml"
    existing = yaml_path.read_text() if yaml_path.exists() else ""
    # Strip any policy block we own (header comment + top-level policy: + indented lines).
    kept = re.sub(
        rf"(?:^{re.escape(POLICY_HEADER)}\n)?^policy:\n(?:[ \t]+.*\n?)*",
        "",
        existing,
        flags=re.M,
    ).strip("\n")
    parts = [kept] if kept else []
    if mode == "user":
        parts.append(POLICY_BLOCK.rstrip("\n"))
    new = ("\n".join(parts) + "\n") if parts else ""
    if new == existing:
        return False
    if new:
        yaml_path.parent.mkdir(exist_ok=True)
        yaml_path.write_text(new)
    elif yaml_path.exists():
        yaml_path.unlink()
        if not any(yaml_path.parent.iterdir()):
            yaml_path.parent.rmdir()
    return True


def cmd_sync():
    changed = 0
    CODEX_SKILLS.mkdir(parents=True, exist_ok=True)
    for d in skill_dirs():
        mode, _ = mode_of(d)
        if mode == "?":
            continue
        if sync_yaml(d, mode):
            changed += 1
        link = CODEX_SKILLS / d.name
        if link.is_symlink():
            if link.resolve() != d.resolve():
                link.unlink()
        elif link.exists():
            print(f"warning: {link} exists and is not a symlink; leaving it alone")
            continue
        if not link.is_symlink():
            link.symlink_to(d)
            changed += 1
    # Prune symlinks pointing at skills we no longer have.
    for link in CODEX_SKILLS.iterdir():
        if link.is_symlink() and not link.resolve().exists():
            target = Path(str(link.readlink()))
            if str(target).startswith(str(SKILLS)):
                link.unlink()
                changed += 1
    print(f"sync: {'no changes' if changed == 0 else f'{changed} change(s)'}")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    cmd, rest = args[0], args[1:]
    if cmd == "list":
        cmd_list()
    elif cmd == "sync":
        cmd_sync()
    elif cmd in ("enable-model", "disable-model") and len(rest) == 1:
        set_flag(rest[0], cmd == "disable-model")
    elif cmd in ("off", "on") and len(rest) == 1:
        set_off(rest[0], cmd == "off")
    else:
        sys.exit(f"skillctl: unknown command {' '.join(args)!r} (see --help)")


if __name__ == "__main__":
    main()
