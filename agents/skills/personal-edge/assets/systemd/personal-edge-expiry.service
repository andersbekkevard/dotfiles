[Unit]
Description=Expire due personal-edge public hostnames
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash -lc 'set -a; source "%h/.secrets"; set +a; exec /usr/bin/python3 "%h/.local/lib/personal-edge/publication_expiry.py" run-due'
PrivateTmp=true
NoNewPrivileges=true
