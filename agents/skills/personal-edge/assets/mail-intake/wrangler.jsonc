{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-edge-mail-intake",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-10",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "TRUSTED_SENDERS_JSON": "[\"anders.bekkevard@gmail.com\",\"anders.bekkevard@odinfond.no\",\"edge-test-sender@bekkevard.me\"]",
    "MAX_RAW_BYTES": "10485760"
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "MAIL_BUCKET",
      "bucket_name": "personal-edge-mail"
    }
  ]
}
