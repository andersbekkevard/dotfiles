{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-edge-mail-intake",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-10",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "MAIL_BUCKET",
      "bucket_name": "personal-edge-mail"
    }
  ]
}
