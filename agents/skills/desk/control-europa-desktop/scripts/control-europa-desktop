#!/usr/bin/env bash
set -euo pipefail

readonly EXPECTED_HOST="europa"
readonly MAC_TARGET="andersbekkevard@anders-sin-macbook-pro.tailbcf03b.ts.net"
readonly DESKTOP_TARGET="agent-desktop.target"
readonly XVFB_UNIT="agent-xvfb.service"
readonly VNC_UNIT="agent-vnc.service"
readonly TUNNEL_UNIT="control-europa-desktop-tunnel.service"
readonly EUROPA_VNC_PORT="5900"
readonly MAC_VNC_PORT_MIN="5901"
readonly MAC_VNC_PORT_MAX="5999"
readonly X_DISPLAY=":99"
readonly X_AUTHORITY="/run/user/1000/agent-desktop/Xauthority"
readonly SESSION_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/control-europa-desktop"
readonly SESSION_FILE="${SESSION_DIR}/mac-port"
OPEN_IN_PROGRESS=0

usage() {
  printf 'usage: %s {open|status|close}\n' "${0##*/}" >&2
}

die() {
  printf 'control-europa-desktop: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

require_europa() {
  local current_host
  current_host="$(hostname -s)"
  [[ "$current_host" == "$EXPECTED_HOST" ]] || \
    die "refusing to run on ${current_host}; expected ${EXPECTED_HOST}"
}

unit_active() {
  systemctl --user is-active --quiet "$1"
}

mac_ssh() {
  ssh \
    -o BatchMode=yes \
    -o ConnectTimeout=10 \
    -o StrictHostKeyChecking=yes \
    "$MAC_TARGET" "$@"
}

read_mac_port() {
  local port
  [[ -r "$SESSION_FILE" ]] || return 1
  IFS= read -r port < "$SESSION_FILE"
  [[ "$port" =~ ^[0-9]+$ ]] || return 1
  (( port >= MAC_VNC_PORT_MIN && port <= MAC_VNC_PORT_MAX )) || return 1
  printf '%s' "$port"
}

save_mac_port() {
  local port="$1"
  mkdir -p "$SESSION_DIR"
  chmod 700 "$SESSION_DIR"
  umask 077
  printf '%s\n' "$port" > "$SESSION_FILE"
}

clear_mac_port() {
  rm -f "$SESSION_FILE"
  rmdir "$SESSION_DIR" >/dev/null 2>&1 || true
}

mac_port_open() {
  local port="${1:-}"
  [[ -n "$port" ]] || port="$(read_mac_port)" || return 1
  mac_ssh /usr/bin/nc -z 127.0.0.1 "$port" >/dev/null 2>&1
}

choose_mac_port() {
  local attempt port range
  range=$((MAC_VNC_PORT_MAX - MAC_VNC_PORT_MIN + 1))
  for attempt in {1..40}; do
    port=$((MAC_VNC_PORT_MIN + RANDOM % range))
    if ! mac_port_open "$port"; then
      printf '%s' "$port"
      return 0
    fi
  done
  die "could not find a free temporary Mac loopback port"
}

verify_vnc_unit() {
  local unit_text password_path password_mode password_owner
  unit_text="$(systemctl --user cat "$VNC_UNIT")" || \
    die "cannot inspect ${VNC_UNIT}"

  [[ "$unit_text" == *" -localhost "* ]] || \
    die "${VNC_UNIT} is missing the loopback-only -localhost guard"
  [[ "$unit_text" == *" -rfbport ${EUROPA_VNC_PORT} "* ]] || \
    die "${VNC_UNIT} does not use expected port ${EUROPA_VNC_PORT}"

  password_path="$(printf '%s\n' "$unit_text" | \
    sed -n 's/.* -rfbauth \([^ ]*\).*/\1/p' | tail -n 1)"
  [[ -n "$password_path" && -f "$password_path" ]] || \
    die "${VNC_UNIT} authentication file is missing"
  password_mode="$(stat -c '%a' "$password_path")"
  password_owner="$(stat -c '%U' "$password_path")"
  [[ "$password_mode" == "600" ]] || \
    die "VNC authentication file must have mode 600"
  [[ "$password_owner" == "$(id -un)" ]] || \
    die "VNC authentication file must be owned by $(id -un)"
}

vnc_password_path() {
  systemctl --user cat "$VNC_UNIT" | \
    sed -n 's/.* -rfbauth \([^ ]*\).*/\1/p' | tail -n 1
}

generate_vnc_password() {
  local candidate
  candidate="$(openssl rand -base64 24)"
  candidate="${candidate//[^[:alnum:]]/}"
  [[ ${#candidate} -ge 8 ]] || die "failed to generate a VNC credential"
  printf '%s' "${candidate:0:8}"
}

store_vnc_password() {
  local password_path="$1" password="$2"
  umask 077
  printf '%s\n%s\ny\n' "$password" "$password" | \
    x11vnc -storepasswd "$password_path" >/dev/null 2>&1
  chmod 600 "$password_path"
}

seal_vnc_password() {
  local password_path sealed_password
  password_path="$(vnc_password_path)"
  [[ -n "$password_path" ]] || die "cannot resolve the VNC authentication file"
  sealed_password="$(generate_vnc_password)"
  store_vnc_password "$password_path" "$sealed_password"
  unset sealed_password
}

vnc_loopback_only() {
  local state recvq sendq local_address peer_address found=0
  while read -r state recvq sendq local_address peer_address; do
    [[ -n "$local_address" ]] || continue
    found=1
    if [[ "$local_address" != "127.0.0.1:${EUROPA_VNC_PORT}" && \
          "$local_address" != "[::1]:${EUROPA_VNC_PORT}" ]]; then
      return 1
    fi
  done < <(ss -H -ltn "sport = :${EUROPA_VNC_PORT}")
  (( found == 1 ))
}

wait_for_open_path() {
  local port="$1" attempt
  for attempt in {1..30}; do
    if unit_active "$VNC_UNIT" && vnc_loopback_only && \
       unit_active "$TUNNEL_UNIT" && mac_port_open "$port"; then
      return 0
    fi
    sleep 0.2
  done
  return 1
}

wait_for_vnc() {
  local attempt
  for attempt in {1..30}; do
    if unit_active "$VNC_UNIT" && vnc_loopback_only; then
      return 0
    fi
    sleep 0.2
  done
  return 1
}

vnc_client_authenticated() {
  local answer
  answer="$(DISPLAY="$X_DISPLAY" XAUTHORITY="$X_AUTHORITY" \
    x11vnc -query client_count -display "$X_DISPLAY" -auth "$X_AUTHORITY" \
    2>/dev/null || true)"
  [[ "$answer" =~ aro=client_count:([1-9][0-9]*) ]]
}

wait_for_authenticated_client() {
  local attempt
  for attempt in {1..100}; do
    if vnc_client_authenticated; then
      return 0
    fi
    sleep 0.2
  done
  return 1
}

wait_for_closed_path() {
  local port="${1:-}" attempt
  for attempt in {1..25}; do
    if ! unit_active "$VNC_UNIT" && ! unit_active "$TUNNEL_UNIT" && \
       { [[ -z "$port" ]] || ! mac_port_open "$port"; }; then
      return 0
    fi
    sleep 0.2
  done
  return 1
}

cleanup_failed_open() {
  local exit_code="$?" password_path sealed_password
  trap - EXIT
  if (( OPEN_IN_PROGRESS == 1 )); then
    systemctl --user stop "$TUNNEL_UNIT" >/dev/null 2>&1 || true
    systemctl --user stop "$VNC_UNIT" >/dev/null 2>&1 || true
    systemctl --user reset-failed "$TUNNEL_UNIT" >/dev/null 2>&1 || true
    systemctl --user reset-failed "$VNC_UNIT" >/dev/null 2>&1 || true
    password_path="$(vnc_password_path 2>/dev/null || true)"
    sealed_password="$(generate_vnc_password 2>/dev/null || true)"
    if [[ -n "$password_path" && -n "$sealed_password" ]]; then
      store_vnc_password "$password_path" "$sealed_password" \
        >/dev/null 2>&1 || true
    fi
    unset sealed_password
    clear_mac_port
  fi
  exit "$exit_code"
}

trap cleanup_failed_open EXIT

open_session() {
  local password_path session_password old_mac_port mac_port

  verify_vnc_unit
  mac_ssh /usr/bin/true >/dev/null || die "Mac SSH endpoint is unavailable"

  systemctl --user start "$DESKTOP_TARGET"
  unit_active "$XVFB_UNIT" || die "${XVFB_UNIT} did not become active"

  systemctl --user stop "$TUNNEL_UNIT" >/dev/null 2>&1 || true
  systemctl --user stop "$VNC_UNIT" >/dev/null 2>&1 || true
  systemctl --user reset-failed "$TUNNEL_UNIT" >/dev/null 2>&1 || true
  systemctl --user reset-failed "$VNC_UNIT" >/dev/null 2>&1 || true
  old_mac_port="$(read_mac_port || true)"
  wait_for_closed_path "$old_mac_port" || \
    die "could not reset the owned remote-control path"
  clear_mac_port

  mac_port="$(choose_mac_port)"
  save_mac_port "$mac_port"
  OPEN_IN_PROGRESS=1

  password_path="$(vnc_password_path)"
  [[ -n "$password_path" ]] || die "cannot resolve the VNC authentication file"
  session_password="$(generate_vnc_password)"
  store_vnc_password "$password_path" "$session_password"

  systemctl --user start "$VNC_UNIT"
  unit_active "$VNC_UNIT" || die "${VNC_UNIT} did not become active"
  if ! wait_for_vnc; then
    systemctl --user stop "$VNC_UNIT" >/dev/null 2>&1 || true
    die "VNC did not become ready on Europa loopback"
  fi

  if ! unit_active "$TUNNEL_UNIT"; then
    systemctl --user reset-failed "$TUNNEL_UNIT" >/dev/null 2>&1 || true
    systemd-run \
      --user \
      --quiet \
      --collect \
      --service-type=exec \
      --unit="$TUNNEL_UNIT" \
      --description="Temporary Europa desktop tunnel to Anders Mac" \
      --property=Restart=on-failure \
      --property=RestartSec=2s \
      /usr/bin/ssh \
        -N -T \
        -o BatchMode=yes \
        -o ConnectTimeout=10 \
        -o StrictHostKeyChecking=yes \
        -o ExitOnForwardFailure=yes \
        -o ServerAliveInterval=30 \
        -o ServerAliveCountMax=3 \
        -R "127.0.0.1:${mac_port}:127.0.0.1:${EUROPA_VNC_PORT}" \
        "$MAC_TARGET"
  fi

  if ! wait_for_open_path "$mac_port"; then
    systemctl --user status "$TUNNEL_UNIT" --no-pager >&2 || true
    die "private Screen Sharing path did not become ready"
  fi

  printf 'open location "vnc://:%s@127.0.0.1:%s"\n' \
    "$session_password" "$mac_port" | \
    mac_ssh /usr/bin/osascript - >/dev/null || \
    die "failed to open authenticated macOS Screen Sharing"
  unset session_password

  if ! wait_for_authenticated_client; then
    die "Screen Sharing did not authenticate without interaction"
  fi
  OPEN_IN_PROGRESS=0

  printf 'session=open\n'
  printf 'mac_endpoint=%s\n' "${MAC_TARGET#*@}"
  printf 'screen_sharing_url=vnc://127.0.0.1:%s\n' "$mac_port"
  printf 'desktop_persistent=yes\n'
  printf 'access_path=temporary\n'
}

status_session() {
  local desktop_state xvfb_state vnc_state vnc_scope tunnel_state mac_state
  local mac_listener vnc_client mac_port session

  desktop_state="$(systemctl --user is-active "$DESKTOP_TARGET" 2>/dev/null || true)"
  xvfb_state="$(systemctl --user is-active "$XVFB_UNIT" 2>/dev/null || true)"
  vnc_state="$(systemctl --user is-active "$VNC_UNIT" 2>/dev/null || true)"
  tunnel_state="$(systemctl --user is-active "$TUNNEL_UNIT" 2>/dev/null || true)"
  mac_port="$(read_mac_port || true)"

  if [[ "$vnc_state" == "active" ]] && vnc_loopback_only; then
    vnc_scope="loopback-only"
    if vnc_client_authenticated; then
      vnc_client="authenticated"
    else
      vnc_client="none"
    fi
  elif [[ "$vnc_state" == "active" ]]; then
    vnc_scope="unsafe"
    vnc_client="unknown"
  else
    vnc_scope="not-listening"
    vnc_client="none"
  fi

  if mac_ssh /usr/bin/true >/dev/null 2>&1; then
    mac_state="reachable"
    if [[ -n "$mac_port" ]] && mac_port_open "$mac_port"; then
      mac_listener="open"
    elif [[ "$tunnel_state" == "active" && -z "$mac_port" ]]; then
      mac_listener="unknown"
    else
      mac_listener="closed"
    fi
  else
    mac_state="unreachable"
    mac_listener="unknown"
  fi

  if [[ "$desktop_state" == "active" && "$xvfb_state" == "active" && \
        "$vnc_state" == "active" && "$vnc_scope" == "loopback-only" && \
        "$vnc_client" == "authenticated" && "$tunnel_state" == "active" && \
        "$mac_listener" == "open" ]]; then
    session="open"
  elif [[ "$vnc_state" != "active" && "$tunnel_state" != "active" && \
          "$mac_listener" != "open" ]]; then
    session="closed"
  else
    session="partial"
  fi

  printf 'session=%s\n' "$session"
  printf 'desktop_target=%s\n' "$desktop_state"
  printf 'xvfb=%s\n' "$xvfb_state"
  printf 'vnc=%s\n' "$vnc_state"
  printf 'vnc_scope=%s\n' "$vnc_scope"
  printf 'vnc_client=%s\n' "$vnc_client"
  printf 'tunnel=%s\n' "$tunnel_state"
  printf 'mac=%s\n' "$mac_state"
  printf 'mac_port=%s\n' "${mac_port:-none}"
  printf 'mac_listener=%s\n' "$mac_listener"
}

close_session() {
  local mac_port
  mac_port="$(read_mac_port || true)"
  systemctl --user stop "$TUNNEL_UNIT" >/dev/null 2>&1 || true
  systemctl --user reset-failed "$TUNNEL_UNIT" >/dev/null 2>&1 || true
  systemctl --user stop "$VNC_UNIT"

  wait_for_closed_path "$mac_port" || \
    die "remote-control path did not close completely"
  systemctl --user reset-failed "$VNC_UNIT" >/dev/null 2>&1 || true
  seal_vnc_password
  clear_mac_port
  unit_active "$DESKTOP_TARGET" || \
    die "${DESKTOP_TARGET} stopped unexpectedly while closing access"
  unit_active "$XVFB_UNIT" || \
    die "${XVFB_UNIT} stopped unexpectedly while closing access"

  printf 'session=closed\n'
  printf 'desktop_persistent=yes\n'
  printf 'access_path=stopped\n'
}

main() {
  if (( $# != 1 )); then
    usage
    exit 2
  fi

  require_command hostname
  require_command ssh
  require_command ss
  require_command stat
  require_command systemctl
  require_command systemd-run
  require_europa

  case "$1" in
    open)
      require_command openssl
      require_command x11vnc
      open_session
      ;;
    status) status_session ;;
    close)
      require_command openssl
      require_command x11vnc
      close_session
      ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
