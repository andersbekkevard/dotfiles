# The root CLAUDE.md is a tracked symlink to AGENTS.md; it must survive a fresh
# clone so repo instructions load on every machine. Do not ignore it here.
.zshrc.local
IMPROVEMENT.md
git-crypt.key
*.key
.claude/

# Machine-specific agent skills projected by setup but never committed.
agents/skills/.local/

# Machine-specific global instruction overlays composed by setup.
agents/.local/

# Private local skill: contains Anders's subscription email candidates.
agents/skills/refund-chatgpt-subscriptions/*
!agents/skills/refund-chatgpt-subscriptions/.gitkeep

# Generated or machine-local state.
.playwright-cli/
nvim/.config/nvim/lazy-lock.json
.DS_Store
agents/skills/reclaim-storage/machine.local.toml

# bv (beads viewer) local config and caches
.bv/
__pycache__/
