[user]
	name = Anders Bekkevard
	email = anders.bekkevard@gmail.com
[credential]
	helper = store
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
[pull]
	rebase = true
[credential "https://github.com"]
	helper = 
	helper = "!f() { helper=\"${HOME:-}/.local/bin/git-credential-gh-safe\"; [ -n \"${HOME:-}\" ] && [ -x \"$helper\" ] || exit 0; \"$helper\" \"$@\"; }; f"
[credential "https://gist.github.com"]
	helper = 
	helper = "!f() { helper=\"${HOME:-}/.local/bin/git-credential-gh-safe\"; [ -n \"${HOME:-}\" ] && [ -x \"$helper\" ] || exit 0; \"$helper\" \"$@\"; }; f"
