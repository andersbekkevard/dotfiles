#!/usr/bin/env bash
set -euo pipefail

config_home="${XDG_CONFIG_HOME:-$HOME/.config}/cliproxyapi"
env_file="${CLIPROXY_ENV_FILE:-$config_home/claudex.env}"

die() {
  printf 'claudex: %s\n' "$*" >&2
  exit 1
}

command -v claude >/dev/null 2>&1 || die "claude is not installed"
command -v claudex-proxy >/dev/null 2>&1 || die "claudex-proxy is not installed"
[[ -r "$env_file" ]] || die "missing $env_file; run ./setup.sh full"

# Generated by setup with mode 0600 and shell-safe values.
# shellcheck disable=SC1090
source "$env_file"
[[ -n "${CLIPROXY_API_KEY:-}" ]] || die "CLIPROXY_API_KEY is missing from $env_file"
: "${CLIPROXY_BASE_URL:=http://127.0.0.1:8317}"

claudex-proxy start >/dev/null

exec env -u ANTHROPIC_API_KEY \
  ANTHROPIC_BASE_URL="$CLIPROXY_BASE_URL" \
  ANTHROPIC_AUTH_TOKEN="$CLIPROXY_API_KEY" \
  CLAUDE_CODE_SUBAGENT_MODEL="${CLAUDEX_SUBAGENT_MODEL:-gpt-5.6-luna}" \
  CLAUDE_CODE_ALWAYS_ENABLE_EFFORT=1 \
  CLAUDE_CODE_AUTO_COMPACT_WINDOW="${CLAUDEX_CONTEXT_WINDOW:-272000}" \
  CLAUDE_AUTOCOMPACT_PCT_OVERRIDE="${CLAUDEX_AUTOCOMPACT_PCT:-88}" \
  CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY="${CLAUDEX_MAX_TOOL_CONCURRENCY:-3}" \
  ENABLE_TOOL_SEARCH="${CLAUDEX_ENABLE_TOOL_SEARCH:-false}" \
  claude --model "${CLAUDEX_MODEL:-gpt-5.6-sol}" \
    --effort "${CLAUDEX_EFFORT:-high}" "$@"
