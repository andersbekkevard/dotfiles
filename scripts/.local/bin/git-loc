        "js": "JavaScript",
        "jsx": "JavaScript",
        "cjs": "JavaScript",
        "mjs": "JavaScript",
        "json": "JSON",
        "jsonc": "JSON",
        "kt": "Kotlin",
        "kts": "Kotlin",
        "less": "Less",
        "lua": "Lua",
        "m": "Objective-C",
        "mm": "Objective-C",
        "ml": "OCaml",
        "mli": "OCaml",
        "nim": "Nim",
