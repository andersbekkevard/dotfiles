        "yarn.lock",
        "cargo.lock",
        "gemfile.lock",
        "poetry.lock",
        "uv.lock",
        "go.sum",
        "composer.lock",
    }:
        return None

    if "." not in lower:
        return None

    ext = lower.rsplit(".", 1)[-1]
    languages = {
        "awk": "Awk",
        "bash": "Shell",
        "sh": "Shell",
        "bat": "Shell",
        "cmd": "Shell",
        "ps1": "Shell",
        "c": "C",
