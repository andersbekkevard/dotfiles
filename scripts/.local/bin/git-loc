#!/usr/bin/env bash
set -euo pipefail

VERSION="0.4.0"
DEFAULT_MAX_BLOB_BYTES=$((10 * 1024 * 1024))
cleanup_paths=()

cleanup() {
  local path
  for path in "${cleanup_paths[@]}"; do
    [[ -n "$path" ]] && rm -rf "$path"
  done
}

register_cleanup() {
  cleanup_paths[${#cleanup_paths[@]}]="$1"
}

trap cleanup EXIT

usage() {
  cat <<'EOF'
usage: git-loc [options] <repo-url>
       git-loc --benchmark-exact [repo-or-url ...]

Count lines of code in a Git repository without checking out the whole tree.

Options:
  --ref <ref>             Branch, tag, or commit-ish to inspect
  --exact                 Count source contents exactly instead of estimating
  --estimate              Use GitHub language byte metadata when possible
  --benchmark-exact       Time exact counts for representative repos or the
                           repos passed after the flag
  --strategy <strategy>   Exact strategy: auto, archive, or partial
                           (default: auto)
  --json                  Print machine-readable JSON
  --no-cache              Ignore cached results for this run
  --include-vendor        Include vendored/generated/build paths
  --include-docs          Include Markdown/reStructuredText/plain docs
  --exclude-tests         Exclude common test/spec paths and filenames
  --max-blob-bytes <n>    Skip individual blobs larger than n bytes
                           (default: 10485760)
  -h, --help              Show this help
  --version               Show version

By default, GitHub URLs use fast language metadata estimates. Use --exact when
you need source-content counts. Exact mode uses a GitHub source archive when
available, or a shallow, blobless partial clone for other Git remotes.

Estimate mode currently supports GitHub URLs and reports a byte-based estimate
from the GitHub languages API. Set GITHUB_TOKEN for private repos or higher API
limits.
EOF
}

die() {
  printf 'git-loc: %s\n' "$*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

is_integer() {
  [[ "${1:-}" =~ ^[0-9]+$ ]]
}

format_int() {
  local n="$1"
  local out=""

  while ((${#n} > 3)); do
    out=",${n: -3}$out"
    n="${n:0:${#n}-3}"
  done

  printf '%s%s\n' "$n" "$out"
}

now_millis() {
  local value

  value="$(date +%s%3N 2>/dev/null || true)"
  if is_integer "$value"; then
    printf '%s\n' "$value"
    return 0
  fi

  printf '%s000\n' "$(date +%s)"
}

format_millis() {
  awk -v ms="$1" 'BEGIN { printf "%.2fs", ms / 1000 }'
}

cache_root() {
  printf '%s/git-loc\n' "${XDG_CACHE_HOME:-"$HOME/.cache"}"
}

cache_repo_key() {
  printf '%s\n%s\nmode=%s\nstrategy=%s\ninclude_vendor=%s\ninclude_docs=%s\nexclude_tests=%s\nmax_blob_bytes=%s\n' \
    "$repo_url" "${ref_name:-HEAD}" "$effective_mode" "$exact_strategy" "$include_vendor" "$include_docs" "$exclude_tests" "$max_blob_bytes" |
    git hash-object --stdin
}

resolve_remote_commit() {
  local output line
  resolved_commit=""

  if [[ -n "$ref_name" ]]; then
    output="$(git ls-remote "$repo_url" "$ref_name" "refs/heads/$ref_name" "refs/tags/$ref_name" 2>/dev/null || true)"
  else
    output="$(git ls-remote --symref "$repo_url" HEAD 2>/dev/null || true)"
  fi

  [[ -n "$output" ]] || return 1

  while IFS= read -r line; do
    case "$line" in
      ref:*)
        default_ref="${line#ref: }"
        default_ref="${default_ref%%	HEAD}"
        default_ref="${default_ref#refs/heads/}"
        ;;
      *$'\t'*)
        case "$line" in
          *'^{}') continue ;;
        esac
        resolved_commit="${line%%	*}"
        return 0
        ;;
    esac
  done <<< "$output"

  return 1
}

github_slug() {
  local url="$1" slug owner repo rest

  case "$url" in
    https://github.com/*)
      slug="${url#https://github.com/}"
      ;;
    http://github.com/*)
      slug="${url#http://github.com/}"
      ;;
    git@github.com:*)
      slug="${url#git@github.com:}"
      ;;
    ssh://git@github.com/*)
      slug="${url#ssh://git@github.com/}"
      ;;
    *)
      return 1
      ;;
  esac

  slug="${slug%%\?*}"
  slug="${slug%%#*}"
  slug="${slug%.git}"
  IFS=/ read -r owner repo rest <<< "$slug"
  [[ -n "$owner" && -n "$repo" ]] || return 1
  printf '%s/%s\n' "$owner" "$repo"
}

language_for_path() {
  local path="$1" base ext lower
  base="${path##*/}"
  lower="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')"

  case "$base" in
    Dockerfile|Containerfile) printf 'Dockerfile\n'; return 0 ;;
    Makefile|makefile|GNUmakefile) printf 'Makefile\n'; return 0 ;;
    CMakeLists.txt) printf 'CMake\n'; return 0 ;;
    Jenkinsfile) printf 'Groovy\n'; return 0 ;;
    Rakefile|Gemfile|Guardfile|Podfile|Fastfile) printf 'Ruby\n'; return 0 ;;
  esac

  case "$lower" in
    *.min.js|*.min.css|*.map) return 1 ;;
    package-lock.json|pnpm-lock.yaml|yarn.lock|cargo.lock|gemfile.lock|poetry.lock|uv.lock|go.sum|composer.lock)
      return 1
      ;;
  esac

  ext="${lower##*.}"
  [[ "$lower" == "$ext" ]] && return 1

  case "$ext" in
    awk) printf 'Awk\n' ;;
    bash|sh) printf 'Shell\n' ;;
    bat|cmd|ps1) printf 'Shell\n' ;;
    c|h) printf 'C\n' ;;
    cc|cpp|cxx|hpp|hxx|hh) printf 'C++\n' ;;
    clj|cljs|cljc|edn) printf 'Clojure\n' ;;
    cmake) printf 'CMake\n' ;;
    cs) printf 'C#\n' ;;
    css) printf 'CSS\n' ;;
    dart) printf 'Dart\n' ;;
    dockerfile) printf 'Dockerfile\n' ;;
    eex|ex|exs|heex) printf 'Elixir\n' ;;
    elm) printf 'Elm\n' ;;
    erl|hrl) printf 'Erlang\n' ;;
    fs|fsi|fsx) printf 'F#\n' ;;
    gleam) printf 'Gleam\n' ;;
    go) printf 'Go\n' ;;
    gql|graphql) printf 'GraphQL\n' ;;
    groovy|gradle) printf 'Groovy\n' ;;
    hcl|tf|tfvars) printf 'HCL\n' ;;
    hs|lhs) printf 'Haskell\n' ;;
    html|htm|xhtml) printf 'HTML\n' ;;
    java) printf 'Java\n' ;;
    js|jsx|cjs|mjs) printf 'JavaScript\n' ;;
    json|jsonc) printf 'JSON\n' ;;
    kt|kts) printf 'Kotlin\n' ;;
    less) printf 'Less\n' ;;
    lua) printf 'Lua\n' ;;
    m|mm) printf 'Objective-C\n' ;;
    md|markdown|rst|txt)
      [[ "$include_docs" -eq 1 ]] || return 1
      printf 'Docs\n'
      ;;
    ml|mli) printf 'OCaml\n' ;;
    nim) printf 'Nim\n' ;;
    php|phtml) printf 'PHP\n' ;;
    pl|pm|t) printf 'Perl\n' ;;
    proto) printf 'Protocol Buffers\n' ;;
    py|pyw) printf 'Python\n' ;;
    r) printf 'R\n' ;;
    rb) printf 'Ruby\n' ;;
    rs) printf 'Rust\n' ;;
    sass|scss) printf 'Sass\n' ;;
    scala|sc) printf 'Scala\n' ;;
    sql) printf 'SQL\n' ;;
    svelte) printf 'Svelte\n' ;;
    swift) printf 'Swift\n' ;;
    toml) printf 'TOML\n' ;;
    ts|tsx|mts|cts) printf 'TypeScript\n' ;;
    vim) printf 'Vim Script\n' ;;
    vue) printf 'Vue\n' ;;
    xml|xsd|xsl) printf 'XML\n' ;;
    yaml|yml) printf 'YAML\n' ;;
    zig) printf 'Zig\n' ;;
    zsh) printf 'Shell\n' ;;
    *)
      return 1
      ;;
  esac
}

is_vendor_path() {
  local path="/$1"

  case "$path" in
    */.bundle/*|*/.cache/*|*/.gradle/*|*/.next/*|*/.nuxt/*|*/.parcel-cache/*|*/.pytest_cache/*|*/.ruff_cache/*|*/.terraform/*|*/.tox/*|*/.turbo/*|*/.venv/*)
      return 0
      ;;
    */__pycache__/*|*/bower_components/*|*/build/*|*/coverage/*|*/deps/*|*/dist/*|*/external/*|*/node_modules/*|*/out/*|*/target/*|*/third_party/*|*/vendor/*)
      return 0
      ;;
    */Carthage/*|*/DerivedData/*|*/Pods/*)
      return 0
      ;;
  esac

  return 1
}

is_test_path() {
  local path="/$1" base lower
  base="${path##*/}"
  lower="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')"

  case "$path" in
    */__tests__/*|*/e2e/*|*/spec/*|*/specs/*|*/test/*|*/tests/*)
      return 0
      ;;
  esac

  case "$lower" in
    *.spec.*|*.test.*|*_spec.*|*_test.*|test_*)
      return 0
      ;;
  esac

  return 1
}

print_progress() {
  local current="$1" total="$2"
  [[ -t 2 ]] || return 0
  (( total > 0 )) || return 0
  printf '\rCounting files: %d/%d' "$current" "$total" >&2
}

finish_progress() {
  [[ -t 2 ]] || return 0
  printf '\n' >&2
}

render_text() {
  local json_file="$1"
  local estimated
  estimated="$(jq -r '.estimated' "$json_file")"

  if [[ "$estimated" == "true" ]]; then
    jq -r '
      "repo: \(.repo)",
      "ref: \(.ref)",
      "commit: \(.commit)",
      "mode: \(.mode)",
      "",
      "estimated lines: \(.estimated_lines)",
      "language bytes: \(.total_bytes)",
      "",
      "Language\tEst. lines\tBytes",
      "--------\t----------\t-----",
      (.languages[] | [.language, .estimated_lines, .bytes] | @tsv)
    ' "$json_file" | awk -F '\t' '
      function commas(n, s, out) {
        s = sprintf("%d", n)
        out = ""
        while (length(s) > 3) {
          out = "," substr(s, length(s) - 2, 3) out
          s = substr(s, 1, length(s) - 3)
        }
        return s out
      }
      NR == 6 {
        split($0, parts, ": ")
        print parts[1] ": " commas(parts[2])
        next
      }
      NR == 7 {
        split($0, parts, ": ")
        print parts[1] ": " commas(parts[2])
        next
      }
      NR <= 8 { print; next }
      NR == 9 { printf "%-22s %12s %12s\n", $1, $2, $3; next }
      NR == 10 { printf "%-22s %12s %12s\n", $1, $2, $3; next }
      NR > 10 { printf "%-22s %12s %12s\n", $1, commas($2), commas($3) }
    '
    return 0
  fi

  jq -r '
    "repo: \(.repo)",
    "ref: \(.ref)",
    "commit: \(.commit)",
    "mode: \(.mode)",
    "",
    "total lines: \(.total_lines)",
    "counted files: \(.counted_files)",
    "skipped files: \(.skipped_files)",
    "selected files: \(.selected_files)",
    "",
    "Language\tLines\tFiles",
      "--------\t-----\t-----",
      (.languages[] | [.language, .lines, .files] | @tsv)
  ' "$json_file" | awk -F '\t' '
    function commas(n, s, out) {
      s = sprintf("%d", n)
      out = ""
      while (length(s) > 3) {
        out = "," substr(s, length(s) - 2, 3) out
        s = substr(s, 1, length(s) - 3)
      }
      return s out
    }
    NR >= 6 && NR <= 9 {
      split($0, parts, ": ")
      print parts[1] ": " commas(parts[2])
      next
    }
    NR <= 10 { print; next }
    NR == 11 { printf "%-22s %12s %8s\n", $1, $2, $3; next }
    NR == 12 { printf "%-22s %12s %8s\n", $1, $2, $3; next }
    NR > 12 { printf "%-22s %12s %8s\n", $1, commas($2), commas($3) }
  '
}

write_exact_json() {
  local aggregate_file="$1" output_file="$2"

  jq -Rn \
    --arg repo "$repo_url" \
    --arg ref "$display_ref" \
    --arg commit "$commit_sha" \
    --arg mode "exact" \
    --argjson total_lines "$total_lines" \
    --argjson counted_files "$counted_files" \
    --argjson selected_files "$selected_files" \
    --argjson skipped_files "$skipped_files" \
    --argjson skipped_binary "$skipped_binary" \
    --argjson skipped_large "$skipped_large" \
    --argjson skipped_filtered "$skipped_filtered" \
    --argjson max_blob_bytes "$max_blob_bytes" \
    '
      [inputs | split("\t") | {
        language: .[0],
        lines: (.[1] | tonumber),
        files: (.[2] | tonumber)
      }] as $languages |
      {
        repo: $repo,
        ref: $ref,
        commit: $commit,
        mode: $mode,
        estimated: false,
        total_lines: $total_lines,
        counted_files: $counted_files,
        selected_files: $selected_files,
        skipped_files: $skipped_files,
        skipped: {
          binary: $skipped_binary,
          large: $skipped_large,
          filtered: $skipped_filtered
        },
        max_blob_bytes: $max_blob_bytes,
        languages: $languages
      }
    ' < "$aggregate_file" > "$output_file"
}

run_estimate() {
  require_cmd curl
  require_cmd jq

  local slug api tmp_body tmp_json
  slug="$(github_slug "$repo_url")" || die "--estimate currently supports GitHub repository URLs only"
  api="https://api.github.com/repos/$slug/languages"
  tmp_body="$(mktemp)"
  tmp_json="$(mktemp)"
  register_cleanup "$tmp_body"
  register_cleanup "$tmp_json"

  if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    curl -fsSL \
      -H 'Accept: application/vnd.github+json' \
      -H "Authorization: Bearer $GITHUB_TOKEN" \
      "$api" > "$tmp_body" ||
      die "failed to read GitHub language metadata for $slug"
  else
    curl -fsSL -H 'Accept: application/vnd.github+json' "$api" > "$tmp_body" ||
      die "failed to read GitHub language metadata for $slug"
  fi

  jq -n \
    --arg repo "$repo_url" \
    --arg ref "$display_ref" \
    --arg commit "$commit_sha" \
    --arg mode "estimate" \
    --slurpfile raw "$tmp_body" \
    '
      ($raw[0] | to_entries | map({
        language: .key,
        bytes: .value,
        estimated_lines: (((.value + 29) / 30) | floor)
      }) | sort_by(-.bytes)) as $languages |
      {
        repo: $repo,
        ref: $ref,
        commit: $commit,
        mode: $mode,
        estimated: true,
        estimator: "github-languages-api bytes / 30",
        total_bytes: (($languages | map(.bytes) | add) // 0),
        estimated_lines: (($languages | map(.estimated_lines) | add) // 0),
        languages: $languages
      }
    ' > "$tmp_json"

  mkdir -p "$(dirname "$cache_file")"
  cp "$tmp_json" "$cache_file"

  if [[ "$json_output" -eq 1 ]]; then
    cat "$tmp_json"
  else
    render_text "$tmp_json"
  fi
}

count_materialized_file() {
  local language="$1" file_path="$2"
  local size lines

  size="$(wc -c < "$file_path" | tr -d '[:space:]')"
  if ! is_integer "$size"; then
    skipped_filtered=$((skipped_filtered + 1))
    return 0
  fi

  if (( size > max_blob_bytes )); then
    skipped_large=$((skipped_large + 1))
    return 0
  fi

  if (( size == 0 )); then
    lines=0
  elif ! LC_ALL=C grep -Iq '' "$file_path"; then
    skipped_binary=$((skipped_binary + 1))
    return 0
  else
    lines="$(awk 'END { print NR + 0 }' "$file_path")"
  fi

  printf '%s\t%s\t1\n' "$language" "$lines" >> "$counts_file"
  total_lines=$((total_lines + lines))
  counted_files=$((counted_files + 1))
}

aggregate_counts() {
  local aggregate_file="$1"

  skipped_files=$((skipped_filtered + skipped_binary + skipped_large))

  if [[ -s "$counts_file" ]]; then
    awk -F '\t' '
      { lines[$1] += $2; files[$1] += $3 }
      END {
        for (language in lines) {
          printf "%s\t%d\t%d\n", language, lines[language], files[language]
        }
      }
    ' "$counts_file" | sort -t $'\t' -k2,2nr > "$aggregate_file"
  else
    : > "$aggregate_file"
  fi
}

github_archive_url() {
  local slug="$1" archive_ref="$2"
  printf 'https://api.github.com/repos/%s/tarball/%s\n' "$slug" "$archive_ref"
}

run_archive_stream_exact() {
  local slug="$1" archive_url="$2" result_file="$3"
  local counter_script
  local -a curl_args

  has_cmd python3 || return 1

  counter_script="$(mktemp)"
  register_cleanup "$counter_script"
  cat > "$counter_script" <<'PY'
import json
import os
import sys
import tarfile

result_file = sys.argv[1]
include_vendor = os.environ["INCLUDE_VENDOR"] == "1"
include_docs = os.environ["INCLUDE_DOCS"] == "1"
exclude_tests = os.environ["EXCLUDE_TESTS"] == "1"
max_blob_bytes = int(os.environ["MAX_BLOB_BYTES"])


def language_for_path(path):
    base = path.rsplit("/", 1)[-1]
    lower = base.lower()

    exact = {
        "Dockerfile": "Dockerfile",
