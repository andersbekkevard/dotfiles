        "cljs": "Clojure",
        "cljc": "Clojure",
        "edn": "Clojure",
        "cmake": "CMake",
        "cs": "C#",
        "css": "CSS",
        "dart": "Dart",
        "dockerfile": "Dockerfile",
        "eex": "Elixir",
        "ex": "Elixir",
        "exs": "Elixir",
        "heex": "Elixir",
        "elm": "Elm",
        "erl": "Erlang",
        "hrl": "Erlang",
        "fs": "F#",
        "fsi": "F#",
        "fsx": "F#",
        "gleam": "Gleam",
        "go": "Go",
        "gql": "GraphQL",
        "graphql": "GraphQL",
        "groovy": "Groovy",
        "gradle": "Groovy",
        "hcl": "HCL",
        "tf": "HCL",
        "tfvars": "HCL",
        "hs": "Haskell",
        "lhs": "Haskell",
        "html": "HTML",
        "htm": "HTML",
        "xhtml": "HTML",
