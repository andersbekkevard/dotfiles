#!/usr/bin/env bash
set -euo pipefail

readonly FLEET_VERSION="0.4.0"
readonly FLEET_KNOWN_HOSTS="${FLEET_KNOWN_HOSTS:-${XDG_CONFIG_HOME:-$HOME/.config}/fleet/known_hosts}"
readonly FLEET_IDENTITY="${FLEET_IDENTITY:-$HOME/.ssh/fleet_ed25519}"
FLEET_HOST_OPTIONS=(
  -o BatchMode=yes
  -o ConnectTimeout=10
  -o StrictHostKeyChecking=yes
  -o "UserKnownHostsFile=$FLEET_KNOWN_HOSTS"
)

activate_fleet_identity() {
  [[ -f "$FLEET_IDENTITY" ]] || return 0
  [[ " ${FLEET_HOST_OPTIONS[*]} " == *" IdentityFile=$FLEET_IDENTITY "* ]] ||
    FLEET_HOST_OPTIONS+=(
      -o "IdentityFile=$FLEET_IDENTITY"
      -o IdentitiesOnly=yes
    )
}

activate_fleet_identity

usage() {
  cat <<'EOF'
Usage:
  fleet list
  fleet enroll
  fleet <machine> check
  fleet <machine> run [--] <command> [arg ...]
  fleet <machine> put [--open] [--force] <local-file>... <destination-directory>
  fleet <machine> get [--force] <remote-file>... <local-directory>
  fleet <machine> open [--app <application>] <path-or-url>...
  fleet <machine> forward [--open] <source-port> [target-port]
  fleet <machine> forward-status <target-port>
  fleet <machine> forward-stop <target-port>

Examples:
  fleet list
  fleet mac check
  fleet europa run -- systemctl --user status ingest-poller
  fleet mac put --open report.html Desktop/
  fleet europa get /tmp/result.json .
  fleet mac open https://example.com
  fleet mac forward --open 3000

Configuration:
  ~/.config/fleet/machines.tsv
  ~/.config/fleet/machines.local.tsv
  ~/.config/fleet/known_hosts
  ~/.ssh/fleet_ed25519

The local registry overrides matching machine names. Fleet uses its tracked
known-hosts file for strict SSH and SCP host verification. `fleet enroll`
authorizes this machine's dedicated client key on Europa and the Mac after
Europa verifies that the request came from Anders's Tailnet identity.
EOF
}

die() {
  printf 'fleet: %s\n' "$*" >&2
  exit 1
}

is_git_crypt_ciphertext() {
  local file="$1" prefix
  [[ -f "$file" ]] || return 1
  prefix="$(LC_ALL=C od -An -tx1 -N10 "$file" 2>/dev/null | tr -d '[:space:]')"
  [[ "$prefix" == "00474954435259505400" ]]
}

require_known_hosts() {
  if is_git_crypt_ciphertext "$FLEET_KNOWN_HOSTS"; then
    die "private host identities are locked; run git-crypt unlock or set FLEET_KNOWN_HOSTS"
  fi
  [[ -f "$FLEET_KNOWN_HOSTS" ]] || die "known-hosts file not found: $FLEET_KNOWN_HOSTS"
}

usage_error() {
  printf 'fleet: %s\n\n' "$*" >&2
  usage >&2
  exit 2
}

config_files() {
  local config_home
  config_home="${XDG_CONFIG_HOME:-$HOME/.config}"

  if [[ -n "${FLEET_CONFIG:-}" ]]; then
    printf '%s\n' "$FLEET_CONFIG"
    [[ -z "${FLEET_LOCAL_CONFIG:-}" ]] || printf '%s\n' "$FLEET_LOCAL_CONFIG"
    return
  fi

  printf '%s\n' "$config_home/fleet/machines.tsv"
  printf '%s\n' "${FLEET_LOCAL_CONFIG:-$config_home/fleet/machines.local.tsv}"
}

effective_machines() {
  local files=() file locked=0
  while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    if is_git_crypt_ciphertext "$file"; then
      locked=1
      continue
    fi
    files+=("$file")
  done < <(config_files)

  if ((${#files[@]} == 0 && locked == 1)); then
    die "private machine registry is locked; run git-crypt unlock or set FLEET_CONFIG"
  fi
  ((${#files[@]})) || die "no machine registry found; expected ${FLEET_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/fleet/machines.tsv}"

  awk -F '\t' '
    /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
    NF != 4 { printf "fleet: invalid registry row at %s:%d\n", FILENAME, FNR > "/dev/stderr"; failed = 1; next }
    $1 !~ /^[a-z0-9][a-z0-9-]*$/ { printf "fleet: invalid machine name at %s:%d\n", FILENAME, FNR > "/dev/stderr"; failed = 1; next }
    $2 !~ /^[A-Za-z0-9_.@:-]+$/ { printf "fleet: invalid SSH target at %s:%d\n", FILENAME, FNR > "/dev/stderr"; failed = 1; next }
    { rows[$1] = $0 }
    END {
      if (failed) exit 1
      for (name in rows) print rows[name]
    }
  ' "${files[@]}" | LC_ALL=C sort -t $'\t' -k1,1
}

load_machine() {
  local requested="$1" row
  row="$(effective_machines | awk -F '\t' -v requested="$requested" '$1 == requested { print; exit }')"
  [[ -n "$row" ]] || die "unknown machine '$requested'; run 'fleet list'"
  IFS=$'\t' read -r MACHINE_NAME MACHINE_TARGET MACHINE_LOCAL_HOSTS MACHINE_CAPABILITIES <<<"$row"
  is_local_machine || require_known_hosts
}

is_local_machine() {
  local local_host registered_hosts
  local_host="$(hostname -s | tr '[:upper:]' '[:lower:]')"
  registered_hosts="$(printf '%s' "$MACHINE_LOCAL_HOSTS" | tr '[:upper:]' '[:lower:]')"
  [[ "$local_host" == "$MACHINE_NAME" ]] || [[ ",$registered_hosts," == *",$local_host,"* ]]
}

has_capability() {
  [[ ",${MACHINE_CAPABILITIES}," == *",$1,"* ]]
}

remote_command() {
  local quoted command=""
  for argument in "$@"; do
    printf -v quoted '%q' "$argument"
    command+="${command:+ }$quoted"
  done
  printf '%s\n' "$command"
}

run_remote() {
  local command
  command="$(remote_command "$@")"
  ssh -T "${FLEET_HOST_OPTIONS[@]}" "$MACHINE_TARGET" "$command"
}

valid_machine_name() {
  [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]]
}

tailscale_identity() {
  command -v tailscale >/dev/null 2>&1 || die "Tailscale is not installed"
  command -v jq >/dev/null 2>&1 || die "jq is required"

  local status
  status="$(tailscale status --json)" || die "Tailscale is not running or signed in"
  [[ "$(jq -r '.BackendState // empty' <<<"$status")" == "Running" ]] ||
    die "Tailscale is not running or signed in"
  printf '%s\n' "$status"
}

ensure_client_identity() {
  local machine_name="$1" ssh_dir public_key temporary_public
  ssh_dir="${FLEET_IDENTITY%/*}"
  public_key="$FLEET_IDENTITY.pub"
  mkdir -p -- "$ssh_dir"
  chmod 700 -- "$ssh_dir"

  if [[ -f "$FLEET_IDENTITY" ]]; then
    chmod 600 -- "$FLEET_IDENTITY"
    if [[ ! -f "$public_key" ]]; then
      temporary_public="$(mktemp "$ssh_dir/fleet-public.XXXXXX")"
      ssh-keygen -y -f "$FLEET_IDENTITY" >"$temporary_public"
      printf ' fleet-client:%s\n' "$machine_name" >>"$temporary_public"
      chmod 644 -- "$temporary_public"
      mv -- "$temporary_public" "$public_key"
    fi
  elif [[ -e "$public_key" ]]; then
    die "$public_key exists without its private key"
  else
    ssh-keygen -q -t ed25519 -N '' -C "fleet-client:$machine_name" -f "$FLEET_IDENTITY"
  fi

  chmod 644 -- "$public_key"
  activate_fleet_identity
}

read_public_key() {
  local destination="$1" key_line remainder fields key_type
  IFS= read -r key_line || die "expected one SSH public key on stdin"
  remainder="$(cat)"
  [[ -z "$(printf '%s' "$remainder" | tr -d '[:space:]')" ]] ||
    die "expected exactly one SSH public key"
  fields="$(awk '{ print NF }' <<<"$key_line")"
  ((fields == 2 || fields == 3)) || die "expected one ed25519 public key"
  key_type="${key_line%% *}"
  [[ "$key_type" == "ssh-ed25519" ]] || die "only ed25519 client keys are accepted"
  printf '%s\n' "$key_line" >"$destination"
  chmod 600 -- "$destination"
  ssh-keygen -l -f "$destination" >/dev/null 2>&1 || die "invalid SSH public key"
}

install_client_key_command() {
  if [[ "${1:-}" == "--check" ]]; then
    (($# == 1)) || usage_error "enroll-install-key --check takes no other arguments"
    command -v ssh-keygen >/dev/null 2>&1 || die "ssh-keygen is required"
    [[ -d "$HOME" && -w "$HOME" ]] || die "home directory is not writable"
    return
  fi

  (($# == 1)) || usage_error "enroll-install-key requires the verified machine name"
  local machine_name="$1" ssh_dir authorized_keys lock_dir key_file key_body canonical temporary fingerprint
  valid_machine_name "$machine_name" || die "invalid machine name '$machine_name'"
  ssh_dir="$HOME/.ssh"
  authorized_keys="$ssh_dir/authorized_keys"
  lock_dir="$ssh_dir/.fleet-authorized-keys.lock"
  mkdir -p -- "$ssh_dir"
  chmod 700 -- "$ssh_dir"
  key_file="$(mktemp "${TMPDIR:-/tmp}/fleet-public-key.XXXXXX")"
  trap "rm -f -- $(printf '%q' "$key_file")" EXIT
  read_public_key "$key_file"
  key_body="$(awk '{ print $2 }' "$key_file")"
  canonical="from=\"100.64.0.0/10,fd7a:115c:a1e0::/48\",no-agent-forwarding,no-X11-forwarding,no-pty ssh-ed25519 $key_body fleet:$machine_name"
  fingerprint="$(ssh-keygen -l -f "$key_file" | awk '{ print $2 }')"

  mkdir -- "$lock_dir" 2>/dev/null || die "authorized_keys is being updated by another process"
  (
    trap 'rm -rf -- "$lock_dir"' EXIT
    touch -- "$authorized_keys"
    chmod 600 -- "$authorized_keys"

    if grep -Fqx -- "$canonical" "$authorized_keys"; then
      printf 'client-key unchanged machine=%s fingerprint=%s\n' "$machine_name" "$fingerprint"
      exit 0
    fi
    if awk -v key="$key_body" '{ for (i = 1; i <= NF; i++) if ($i == key) found = 1 } END { exit !found }' "$authorized_keys"; then
      die "the client key already exists under a different authorization policy"
    fi
    if grep -Eq "(^|[[:space:]])fleet:${machine_name}([[:space:]]|$)" "$authorized_keys"; then
      die "machine '$machine_name' already has a different enrolled key"
    fi

    temporary="$(mktemp "$ssh_dir/authorized_keys.fleet.XXXXXX")"
    cat -- "$authorized_keys" >"$temporary"
    if [[ -s "$temporary" ]] && ! tail -c 1 "$temporary" | grep -q '^$'; then
      printf '\n' >>"$temporary"
    fi
    printf '%s\n' "$canonical" >>"$temporary"
    chmod 600 -- "$temporary"
    mv -- "$temporary" "$authorized_keys"
    printf 'client-key installed machine=%s fingerprint=%s\n' "$machine_name" "$fingerprint"
  )
  rm -f -- "$key_file"
  trap - EXIT
}

render_client_key_installer() {
  local machine_name="$1" key_file="$2"
  printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail'
  declare -f die usage_error valid_machine_name read_public_key install_client_key_command
  printf '\ninstall_client_key_command %q <<'\''FLEET_PUBLIC_KEY'\''\n' "$machine_name"
  cat -- "$key_file"
  printf '%s\n' 'FLEET_PUBLIC_KEY'
}

authorize_enrollment_command() {
  (($# == 0)) || usage_error "enroll-authorize takes no arguments"
  [[ -n "${SSH_CONNECTION:-}" ]] || die "enroll-authorize must arrive through Tailscale SSH"
  command -v tailscale >/dev/null 2>&1 || die "Tailscale is not installed on the registrar"
  command -v jq >/dev/null 2>&1 || die "jq is required on the registrar"

  local source_ip status whois owner_id machine_name tags key_file fingerprint
  source_ip="${SSH_CONNECTION%% *}"
  status="$(tailscale status --json)"
  whois="$(tailscale whois --json "$source_ip")" || die "the requesting Tailnet node could not be identified"
  owner_id="$(jq -r '.Self.UserID // empty' <<<"$status")"
  [[ -n "$owner_id" && "$(jq -r '.Node.User // empty' <<<"$whois")" == "$owner_id" ]] ||
    die "the requesting node is not owned by the registrar's Tailnet user"
  [[ "$(jq -r '.Node.MachineAuthorized // false' <<<"$whois")" == "true" ]] ||
    die "the requesting Tailnet node is not authorized"
  tags="$(jq -r '(.Node.Tags // []) | length' <<<"$whois")"
  [[ "$tags" == "0" ]] || die "tagged Tailnet nodes cannot enroll client keys"
  machine_name="$(jq -r '.Node.Hostinfo.Hostname // .Node.ComputedName // empty' <<<"$whois" | tr '[:upper:]' '[:lower:]')"
  valid_machine_name "$machine_name" || die "the Tailnet hostname '$machine_name' is not a valid Fleet machine name"

  key_file="$(mktemp "${TMPDIR:-/tmp}/fleet-enrollment.XXXXXX")"
  trap "rm -f -- $(printf '%q' "$key_file")" EXIT
  read_public_key "$key_file"
  fingerprint="$(ssh-keygen -l -f "$key_file" | awk '{ print $2 }')"

  "$0" enroll-install-key --check
  fleet mac run -- /bin/bash -c 'command -v ssh-keygen >/dev/null && test -d "$HOME" && test -w "$HOME"'
  render_client_key_installer "$machine_name" "$key_file" | fleet mac run -- /bin/bash
  "$0" enroll-install-key "$machine_name" <"$key_file"
  printf 'enrollment authorized machine=%s fingerprint=%s targets=europa,mac\n' "$machine_name" "$fingerprint"
  rm -f -- "$key_file"
  trap - EXIT
}

enroll_command() {
  (($# == 0)) || usage_error "enroll takes no arguments"
  command -v ssh-keygen >/dev/null 2>&1 || die "ssh-keygen is required"
  local status machine_name public_key
  status="$(tailscale_identity)"
  machine_name="$(jq -r '.Self.HostName // empty' <<<"$status" | tr '[:upper:]' '[:lower:]')"
  valid_machine_name "$machine_name" || die "the local Tailnet hostname '$machine_name' is not a valid Fleet machine name"
  ensure_client_identity "$machine_name"
  public_key="$FLEET_IDENTITY.pub"

  load_machine europa
  tailscale ssh "$MACHINE_TARGET" "/bin/sh -lc 'fleet enroll-authorize'" <"$public_key"
  "$0" europa check
  "$0" mac check
  printf 'enrolled machine=%s identity=%s targets=europa,mac\n' "$machine_name" "$FLEET_IDENTITY"
}

run_on_machine() {
  if is_local_machine; then
    "$@"
  else
    run_remote "$@"
  fi
}

normalize_home_path() {
  case "$1" in
    '~/'*) printf '%s\n' "${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

local_machine_path() {
  local path
  path="$(normalize_home_path "$1")"
  case "$path" in
    /*) printf '%s\n' "$path" ;;
    *) printf '%s/%s\n' "$HOME" "$path" ;;
  esac
}

join_path() {
  local directory="${1%/}"
  printf '%s/%s\n' "${directory:-/}" "$2"
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum -- "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 -- "$1" | awk '{print $1}'
  else
    die "neither sha256sum nor shasum is available"
  fi
}

sha256_on_machine() {
  local path="$1" script
  if is_local_machine; then
    sha256_file "$(local_machine_path "$path")"
    return
  fi

  script='if command -v sha256sum >/dev/null 2>&1; then sha256sum -- "$1" | awk '\''{print $1}'\''; elif command -v shasum >/dev/null 2>&1; then shasum -a 256 -- "$1" | awk '\''{print $1}'\''; else printf '\''fleet: neither sha256sum nor shasum is available\n'\'' >&2; exit 1; fi'
  run_remote /bin/sh -c "$script" fleet-sha256 "$(normalize_home_path "$path")"
}

path_exists_on_machine() {
  local path="$1"
  if is_local_machine; then
    [[ -e "$(local_machine_path "$path")" ]]
  else
    run_remote test -e "$(normalize_home_path "$path")"
  fi
}

require_unique_basenames() {
  local paths=("$@") left right
  for ((left = 0; left < ${#paths[@]}; left++)); do
    for ((right = left + 1; right < ${#paths[@]}; right++)); do
      [[ "${paths[$left]##*/}" != "${paths[$right]##*/}" ]] ||
        die "duplicate basename '${paths[$left]##*/}' would overwrite a transferred file"
    done
  done
}

open_command() {
  local application="$1"
  shift
  has_capability open || die "machine '$MACHINE_NAME' does not support open"

  if [[ -n "$application" ]]; then
    run_on_machine /usr/bin/open -a "$application" -- "$@"
  else
    run_on_machine /usr/bin/open -- "$@"
  fi
}

is_port() {
  [[ "$1" =~ ^[0-9]+$ ]] && ((10#$1 >= 1 && 10#$1 <= 65535))
}

forward_paths() {
  local target_port="$1" runtime_root
  runtime_root="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}/fleet-$UID}"
  FORWARD_STATE_DIR="$runtime_root/fleet-forwards"
  mkdir -p -- "$FORWARD_STATE_DIR"
  chmod 700 -- "$FORWARD_STATE_DIR"
  FORWARD_SOCKET="$FORWARD_STATE_DIR/${MACHINE_NAME}-${target_port}.sock"
  FORWARD_STATE="$FORWARD_STATE_DIR/${MACHINE_NAME}-${target_port}.tsv"
}

load_forward_state() {
  local expected_port="$1"
  forward_paths "$expected_port"
  [[ -f "$FORWARD_STATE" ]] || return 1
  IFS=$'\t' read -r FORWARD_MACHINE FORWARD_TARGET FORWARD_SOURCE_PORT \
    FORWARD_TARGET_PORT FORWARD_URL <"$FORWARD_STATE"
  [[ "$FORWARD_MACHINE" == "$MACHINE_NAME" ]] || die "invalid forward state for '$MACHINE_NAME'"
  [[ "$FORWARD_TARGET_PORT" == "$expected_port" ]] || die "invalid forward state for port $expected_port"
}

forward_is_active() {
  [[ -e "$FORWARD_SOCKET" ]] &&
    ssh -T "${FLEET_HOST_OPTIONS[@]}" -S "$FORWARD_SOCKET" -O check "$FORWARD_TARGET" \
      >/dev/null 2>&1
}

remove_stale_forward() {
  rm -f -- "$FORWARD_SOCKET" "$FORWARD_STATE"
}

forward_command() {
  local open_after=0 source_port target_port url

  if [[ "${1:-}" == "--open" ]]; then
    open_after=1
    shift
  elif [[ "${1:-}" == --* ]]; then
    usage_error "unknown forward option '${1:-}'"
  fi
  (($# >= 1 && $# <= 2)) || usage_error "forward requires a source port and optional target port"
  source_port="$1"
  target_port="${2:-$source_port}"
  is_port "$source_port" || usage_error "invalid source port '$source_port'"
  is_port "$target_port" || usage_error "invalid target port '$target_port'"
  is_local_machine && die "machine '$MACHINE_NAME' is this host; use http://127.0.0.1:$source_port directly"
  ((open_after == 0)) || has_capability open || die "machine '$MACHINE_NAME' does not support open"

  url="http://127.0.0.1:$target_port/"
  curl -sS -o /dev/null --max-time 5 "http://127.0.0.1:$source_port/" ||
    die "no HTTP service answered on this host at http://127.0.0.1:$source_port/"

  forward_paths "$target_port"
  if [[ -f "$FORWARD_STATE" ]]; then
    load_forward_state "$target_port"
    if forward_is_active; then
      die "$MACHINE_NAME:$target_port is already forwarded; use 'fleet $MACHINE_NAME forward-status $target_port'"
    fi
    remove_stale_forward
  fi

  ssh -T "${FLEET_HOST_OPTIONS[@]}" \
    -M -S "$FORWARD_SOCKET" -fN \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -R "127.0.0.1:${target_port}:127.0.0.1:${source_port}" \
    "$MACHINE_TARGET"

  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$MACHINE_NAME" "$MACHINE_TARGET" "$source_port" "$target_port" "$url" >"$FORWARD_STATE"
  chmod 600 -- "$FORWARD_STATE"
  load_forward_state "$target_port"
  if ! forward_is_active || ! run_remote /usr/bin/curl -sS -o /dev/null --max-time 5 "$url"; then
    ssh -T "${FLEET_HOST_OPTIONS[@]}" -S "$FORWARD_SOCKET" -O exit "$MACHINE_TARGET" \
      >/dev/null 2>&1 || true
    remove_stale_forward
    die "forward started but $url was not reachable from $MACHINE_NAME"
  fi

  printf 'forward %s:127.0.0.1:%s -> %s:127.0.0.1:%s url=%s\n' \
    "$(hostname -s)" "$source_port" "$MACHINE_NAME" "$target_port" "$url"
  printf 'stop with: fleet %s forward-stop %s\n' "$MACHINE_NAME" "$target_port"
  ((open_after == 0)) || open_command "" "$url"
}

forward_status_command() {
  local target_port="$1"
  is_port "$target_port" || usage_error "invalid target port '$target_port'"
  if ! load_forward_state "$target_port"; then
    printf 'stopped machine=%s target_port=%s\n' "$MACHINE_NAME" "$target_port"
    return 1
  fi
  if ! forward_is_active; then
    remove_stale_forward
    printf 'stopped machine=%s target_port=%s stale_state_removed=true\n' "$MACHINE_NAME" "$target_port"
    return 1
  fi
  printf 'active machine=%s source_port=%s target_port=%s url=%s\n' \
    "$MACHINE_NAME" "$FORWARD_SOURCE_PORT" "$FORWARD_TARGET_PORT" "$FORWARD_URL"
}

forward_stop_command() {
  local target_port="$1"
  is_port "$target_port" || usage_error "invalid target port '$target_port'"
  load_forward_state "$target_port" || die "no recorded forward for $MACHINE_NAME:$target_port"
  if forward_is_active; then
    ssh -T "${FLEET_HOST_OPTIONS[@]}" -S "$FORWARD_SOCKET" -O exit "$FORWARD_TARGET" >/dev/null
  fi
  remove_stale_forward
  printf 'stopped machine=%s target_port=%s\n' "$MACHINE_NAME" "$target_port"
}

put_command() {
  local open_after=0 force=0 destination destination_path source basename expected observed target_path
  local arguments=("$@") sources=() copied_paths=()

  while [[ "${arguments[0]:-}" == --* ]]; do
    case "${arguments[0]}" in
      --open) open_after=1 ;;
      --force) force=1 ;;
      *) usage_error "unknown put option '${arguments[0]}'" ;;
    esac
    arguments=("${arguments[@]:1}")
  done
  ((${#arguments[@]} >= 2)) || usage_error "put requires at least one file and a destination directory"

  destination="${arguments[${#arguments[@]}-1]}"
  destination="$(normalize_home_path "$destination")"
  unset 'arguments[${#arguments[@]}-1]'
  sources=("${arguments[@]}")
  require_unique_basenames "${sources[@]}"
  for source in "${sources[@]}"; do
    [[ -f "$source" ]] || die "local file not found: $source"
    target_path="$(join_path "$destination" "${source##*/}")"
    if ((force == 0)) && path_exists_on_machine "$target_path"; then
      die "$MACHINE_NAME:$target_path already exists; rerun with --force to replace it"
    fi
  done

  if is_local_machine; then
    destination_path="$(local_machine_path "$destination")"
    mkdir -p -- "$destination_path"
    cp -p -- "${sources[@]}" "$destination_path/"
  else
    run_remote mkdir -p -- "$destination"
    scp "${FLEET_HOST_OPTIONS[@]}" -p -- "${sources[@]}" "$MACHINE_TARGET:$destination/"
  fi

  for source in "${sources[@]}"; do
    basename="${source##*/}"
    expected="$(sha256_file "$source")"
    observed="$(sha256_on_machine "$(join_path "$destination" "$basename")")"
    [[ "$expected" == "$observed" ]] || die "checksum mismatch after putting $source on $MACHINE_NAME"
    copied_paths+=("$(join_path "$destination" "$basename")")
    printf 'put %s -> %s:%s sha256=%s\n' "$source" "$MACHINE_NAME" "${copied_paths[${#copied_paths[@]}-1]}" "$observed"
  done

  ((open_after == 0)) || open_command "" "${copied_paths[@]}"
}

get_command() {
  local force=0 destination source source_path basename expected observed local_path
  local arguments=("$@") sources=()

  if [[ "${arguments[0]:-}" == "--force" ]]; then
    force=1
    arguments=("${arguments[@]:1}")
  elif [[ "${arguments[0]:-}" == --* ]]; then
    usage_error "unknown get option '${arguments[0]}'"
  fi
  ((${#arguments[@]} >= 2)) || usage_error "get requires at least one file and a local destination directory"
  destination="${arguments[${#arguments[@]}-1]}"
  unset 'arguments[${#arguments[@]}-1]'
  sources=("${arguments[@]}")
  require_unique_basenames "${sources[@]}"
  mkdir -p -- "$destination"

  for source in "${sources[@]}"; do
    source_path="$(normalize_home_path "$source")"
    expected="$(sha256_on_machine "$source_path")"
    basename="${source_path##*/}"
    local_path="${destination%/}/$basename"
    if ((force == 0)) && [[ -e "$local_path" ]]; then
      die "$local_path already exists; rerun with --force to replace it"
    fi

    if is_local_machine; then
      cp -p -- "$(local_machine_path "$source_path")" "$destination/"
    else
      scp "${FLEET_HOST_OPTIONS[@]}" -p -- "$MACHINE_TARGET:$source_path" "$destination/"
    fi

    observed="$(sha256_file "$local_path")"
    [[ "$expected" == "$observed" ]] || die "checksum mismatch after getting $source from $MACHINE_NAME"
    printf 'get %s:%s -> %s sha256=%s\n' "$MACHINE_NAME" "$source_path" "$local_path" "$observed"
  done
}

list_command() {
  printf '%-14s %-62s %s\n' NAME TARGET CAPABILITIES
  effective_machines | while IFS=$'\t' read -r name target _ capabilities; do
    [[ "$capabilities" == "-" ]] && capabilities=""
    printf '%-14s %-62s %s\n' "$name" "$target" "${capabilities:--}"
  done
}

check_command() {
  if is_local_machine; then
    printf '%s local host=%s user=%s\n' "$MACHINE_NAME" "$(hostname -s)" "$(id -un)"
  else
    printf '%s remote target=%s ' "$MACHINE_NAME" "$MACHINE_TARGET"
    run_remote /bin/sh -c 'printf '\''host=%s user=%s\n'\'' "$(hostname -s)" "$(id -un)"'
  fi
}

if (($# == 0)); then
  usage
  exit 0
fi

case "$1" in
  -h|--help|help)
    usage
    exit 0
    ;;
  --version|version)
    printf 'fleet %s\n' "$FLEET_VERSION"
    exit 0
    ;;
  list)
    (($# == 1)) || usage_error "list takes no arguments"
    list_command
    exit 0
    ;;
  enroll)
    shift
    enroll_command "$@"
    exit 0
    ;;
  enroll-authorize)
    shift
    authorize_enrollment_command "$@"
    exit 0
    ;;
  enroll-install-key)
    shift
    install_client_key_command "$@"
    exit 0
    ;;
esac

machine="$1"
shift
load_machine "$machine"
operation="${1:-}"
[[ -n "$operation" ]] || usage_error "missing operation for machine '$machine'"
shift

case "$operation" in
  check)
    (($# == 0)) || usage_error "check takes no arguments"
    check_command
    ;;
  run)
    [[ "${1:-}" != "--" ]] || shift
    (($#)) || usage_error "run requires a command"
    run_on_machine "$@"
    ;;
  put)
    put_command "$@"
    ;;
  get)
    get_command "$@"
    ;;
  open)
    application=""
    if [[ "${1:-}" == "--app" ]]; then
      (($# >= 3)) || usage_error "open --app requires an application and at least one path or URL"
      application="$2"
      shift 2
    fi
    (($#)) || usage_error "open requires at least one path or URL"
    open_command "$application" "$@"
    ;;
  forward)
    forward_command "$@"
    ;;
  forward-status)
    (($# == 1)) || usage_error "forward-status requires a target port"
    forward_status_command "$1"
    ;;
  forward-stop)
    (($# == 1)) || usage_error "forward-stop requires a target port"
    forward_stop_command "$1"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage_error "unknown operation '$operation'"
    ;;
esac
