#!/usr/bin/env sh

find_gh() {
  if command -v gh >/dev/null 2>&1; then
    command -v gh
    return 0
  fi

  if [ -n "${HOME:-}" ] && [ -x "$HOME/.local/bin/gh" ]; then
    printf '%s\n' "$HOME/.local/bin/gh"
    return 0
  fi

  for candidate in \
    /opt/homebrew/bin/gh \
    /usr/local/bin/gh \
    /home/linuxbrew/.linuxbrew/bin/gh \
    /usr/bin/gh
  do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

gh_bin="$(find_gh || true)"

# If GitHub CLI is absent, let Git continue to its normal prompt/fallback path.
[ -n "$gh_bin" ] || exit 0

exec "$gh_bin" auth git-credential "$@"
