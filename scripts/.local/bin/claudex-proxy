#!/usr/bin/env bash
set -euo pipefail

config_home="${XDG_CONFIG_HOME:-$HOME/.config}/cliproxyapi"
state_home="${XDG_STATE_HOME:-$HOME/.local/state}/cliproxyapi"
config_file="${CLIPROXY_CONFIG:-$config_home/config.yaml}"
env_file="${CLIPROXY_ENV_FILE:-$config_home/claudex.env}"
pid_file="$state_home/cli-proxy-api.pid"
log_file="$state_home/cli-proxy-api.log"

usage() {
  cat <<'EOF'
usage: claudex-proxy <command>

Manage the machine-local CLIProxyAPI process used by claudex.

Commands:
  login    Authenticate this machine with Codex OAuth
  start    Start the localhost proxy in the background
  stop     Stop the managed proxy process
  restart  Restart the managed proxy process
  status   Report whether the proxy is reachable
  logs     Follow the proxy log
EOF
}

die() {
  printf 'claudex-proxy: %s\n' "$*" >&2
  exit 1
}

require_runtime() {
  command -v cli-proxy-api >/dev/null 2>&1 ||
    die "cli-proxy-api is not installed; run ./setup.sh full"
  [[ -r "$config_file" ]] ||
    die "missing $config_file; run ./setup.sh full"
  [[ -r "$env_file" ]] ||
    die "missing $env_file; run ./setup.sh full"

  # Generated by setup with mode 0600 and shell-safe values.
  # shellcheck disable=SC1090
  source "$env_file"
  [[ -n "${CLIPROXY_API_KEY:-}" ]] || die "CLIPROXY_API_KEY is missing from $env_file"
  : "${CLIPROXY_BASE_URL:=http://127.0.0.1:8317}"
}

proxy_pid() {
  [[ -r "$pid_file" ]] || return 1
  local pid
  pid="$(cat "$pid_file")"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  printf '%s\n' "$pid"
}

proxy_ready() {
  curl -fsS --max-time 2 \
    -H "Authorization: Bearer $CLIPROXY_API_KEY" \
    "$CLIPROXY_BASE_URL/v1/models" >/dev/null 2>&1
}

start_proxy() {
  require_runtime
  if proxy_ready; then
    printf 'claudex-proxy: ready at %s\n' "$CLIPROXY_BASE_URL"
    return 0
  fi

  mkdir -p "$state_home"
  rm -f "$pid_file"
  nohup cli-proxy-api -config "$config_file" >>"$log_file" 2>&1 &
  printf '%s\n' "$!" >"$pid_file"

  local attempt
  for attempt in {1..30}; do
    if proxy_ready; then
      printf 'claudex-proxy: started at %s (pid %s)\n' \
        "$CLIPROXY_BASE_URL" "$(cat "$pid_file")"
      return 0
    fi
    sleep 0.2
  done

  die "proxy did not become ready; inspect $log_file"
}

stop_proxy() {
  require_runtime
  local pid
  if ! pid="$(proxy_pid)"; then
    rm -f "$pid_file"
    printf 'claudex-proxy: not running as a managed process\n'
    return 0
  fi

  kill "$pid"
  local attempt
  for attempt in {1..20}; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  rm -f "$pid_file"
  printf 'claudex-proxy: stopped pid %s\n' "$pid"
}

command_name="${1:-}"
case "$command_name" in
  login)
    require_runtime
    exec cli-proxy-api -config "$config_file" -codex-login
    ;;
  start)
    start_proxy
    ;;
  stop)
    stop_proxy
    ;;
  restart)
    stop_proxy
    start_proxy
    ;;
  status)
    require_runtime
    if proxy_ready; then
      printf 'claudex-proxy: ready at %s\n' "$CLIPROXY_BASE_URL"
    else
      printf 'claudex-proxy: unavailable at %s\n' "$CLIPROXY_BASE_URL" >&2
      exit 1
    fi
    ;;
  logs)
    mkdir -p "$state_home"
    touch "$log_file"
    exec tail -f "$log_file"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
